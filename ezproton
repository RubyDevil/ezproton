def resolve_arg(text):
    if text == "~" or text.startswith("~/"):
        text = HOME + text[1:]
    return os.path.normpath(os.path.abspath(text))


def select(config, kind, paths):
    """The backup entries and/or sync pairs a command covers."""
    backups = config.backups if kind in (None, "backup") else []
    pairs = config.pairs if kind in (None, "sync") else []
    if not paths:
        return list(backups), list(pairs)
    chosen_b, chosen_p = [], []
    for text in paths:
        path = resolve_arg(text)
        b = next((e for e in config.backups if e.local == path), None)
        p = next((e for e in config.pairs if e.local == path), None)
        if b and kind in (None, "backup"):
            chosen_b.append(b)
        elif p and kind in (None, "sync"):
            chosen_p.append(p)
        elif b or p:
            other = "backup" if b else "sync"
            raise UsageError(f"{show(path)} is set up for {other}, not {kind}.")
        else:
            configured = [f"  backup  {show(e.local)}" for e in config.backups] + [
                f"  sync    {show(e.local)} : {e.remote}" for e in config.pairs]
            raise UsageError(f"{show(path)} isn't configured. Configured:\n" + ("\n".join(configured) or "  (nothing)"))
    return chosen_b, chosen_p



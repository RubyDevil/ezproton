def print_plan(plan, config):
    entry = plan.entry
    base = os.path.dirname(entry.local) if entry.kind == "backup" and os.path.isfile(entry.local) else entry.local
    label = f"{show(entry.local)}" + (f" : {entry.remote}" if entry.kind == "sync" else f"  →  {entry.remote}")
    print(f"{BOLD}{entry.kind} {label}{RESET}")
    if not plan.actions:
        print(f"  {DIM}nothing to do{RESET}")
    lines = []
    for action in plan.actions:
        what = LABELS[action.op]
        if action.op in ("upload_dir", "download_dir"):
            # Whole folders are listed file by file, so the preview shows everything.
            items = plan.scan.entries if action.op == "upload_dir" else (plan.remote or {})
            inside = sorted(r for r, e in items.items() if is_under(r, action.rel) and e.type == "file")
            lines.extend((what, r) for r in inside)
            if not inside:
                lines.append(("create folder on Drive" if action.op == "upload_dir" else "create folder locally",
                              action.rel))
            continue
        if action.op in ("upload", "download") and not action.new:
            what += " (new version)" if action.op == "upload" else " (replace)"
        if action.op in ("trash_remote", "trash_local") and action.count > 1:
            what += f" ({plural(action.count, 'file')})"
        lines.append((what, action.rel))
    for what, rel in sorted(lines, key=lambda x: (x[0], x[1])):
        shown_path = show(rel_join(base, rel)) if rel else show(base)
        print(f"  {what:<28} {shown_path}")
    for note in plan.notes:
        print(f"  {YELLOW}{note}{RESET}")


def preflight(config, backups, pairs, drive, need_drive):
    missing = [e.local for e in backups + pairs if not os.path.lexists(e.local)]
    if missing:
        raise EzError("these are configured but don't exist, so nothing was done:\n"
                      + "\n".join(f"  {show(m)}" for m in missing)
                      + "\nFix or remove those lines with \"ezproton edit\".")
    if need_drive:
        drive.check_login()


def cmd_run(kind, paths, yes):
    config = config_or_die()
    backups, pairs = select(config, kind, paths)
    entries = backups if kind == "backup" else pairs
    if not entries:
        print(f"Nothing is set up for {kind}. Add some with \"ezproton edit {kind}\".")
        return OK
    with Lock():
        drive = Drive()
        preflight(config, backups if kind == "backup" else [], pairs if kind == "sync" else [], drive, True)
        plans = []
        for entry in entries:
            plans.append(plan_backup(entry, config, drive) if kind == "backup" else plan_sync(entry, config, drive))
        total = sum(p.deletions for p in plans)
        if total > config.delete_limit and not yes:
            for plan in plans:
                if plan.deletions:
                    print_plan(plan, config)
            print(f"\n{RED}This run would delete {plural(total, 'item')}, more than the limit of "
                  f"{config.delete_limit}. Nothing was changed.{RESET}")
            print("Check the list above (or run \"ezproton preview\"), then repeat with --yes to go ahead.")
            return LIMIT
        worst = OK
        for plan in plans:
            entry = plan.entry
            started = time.time()
            prev = load_state(entry)
            outcome = Outcome()
            entry_drive = Drive()
            try:
                (run_backup if kind == "backup" else run_sync)(plan, config, entry_drive, outcome)
            except EzError as error:
                write_record(entry, "failed", started, outcome, entry_drive, prev, str(error))
                raise
            result = "partial" if outcome.partial else "success"
            write_record(entry, result, started, outcome, entry_drive, prev)
            summary = describe(outcome, kind)
            colour = YELLOW if outcome.partial else GREEN
            print(f"{colour}{kind} {show(entry.local)}: {result}{RESET}  {summary}")
            for line in outcome.skipped + outcome.failed:
                print(f"  {YELLOW}skipped: {line}{RESET}")
            if outcome.partial:
                worst = PARTIAL
        return worst


def describe(outcome, kind):
    parts = []
    if outcome.uploaded:
        parts.append(f"{plural(outcome.uploaded, 'file')} uploaded")
    if outcome.downloaded:
        parts.append(f"{outcome.downloaded} downloaded")
    if outcome.conflicts:
        parts.append(plural(outcome.conflicts, "conflict"))
    if outcome.trashed_remote:
        parts.append(f"{outcome.trashed_remote} to Drive's trash")
    if outcome.trashed_local:
        parts.append(f"{outcome.trashed_local} to the desktop trash")
    return ", ".join(parts) or "nothing to do"


def cmd_check(kind, paths):
    config = load_config()
    problems = list(config.problems)
    for message in config.warnings:
        warn(message)
    backups, pairs = select(config, kind, paths) if not problems else (
        config.backups if kind in (None, "backup") else [], config.pairs if kind in (None, "sync") else [])
    drive = Drive()
    try:
        drive.check_login()
        login = f"{GREEN}logged in{RESET}"
        online = True
    except DriveError as error:
        login = f"{RED}{str(error).splitlines()[0]}{RESET}"
        online = False
    print(f"{BOLD}Proton Drive:{RESET} {login}")
    if kind in (None, "backup"):
        print(f"{BOLD}Backup root:{RESET}  {config.backup_root}")
    print(f"{BOLD}Deletion limit:{RESET} {config.delete_limit} per run\n")

    if kind in (None, "backup"):
        print(f"{BOLD}Backup{RESET}")
        if not backups:
            print(f"  {DIM}nothing set up (ezproton edit backup){RESET}")
        for entry in backups:
            exists = os.path.lexists(entry.local)
            if not exists:
                problems.append(f"{show(entry.local)} doesn't exist")
                print(f"  {show(entry.local):<30} {RED}missing{RESET}")
                continue
            single = os.path.isfile(entry.local)
            scan = scan_local(entry.local, config, single_file=single)
            files = [e for e in scan.entries.values() if e.type == "file"]
            size = sum(e.size for e in files)
            print(f"  {show(entry.local):<30} {plural(len(files), 'file')}, {human(size)}, "
                  f"{len(scan.excluded)} excluded, mode {entry.mode}")
            print(f"  {'':<30} {DIM}→ {entry.remote}   last: {last_line(entry)}{RESET}")
            if scan.unreadable:
                print(f"  {'':<30} {YELLOW}{plural(len(scan.unreadable), 'item')} can't be read{RESET}")
        print()
    if kind in (None, "sync"):
        print(f"{BOLD}Sync{RESET}")
        if not pairs:
            print(f"  {DIM}nothing set up (ezproton edit sync){RESET}")
        remote_exists = {}
        if online and pairs:
            with concurrent.futures.ThreadPoolExecutor(LIST_WORKERS) as pool:
                remote_exists = dict(zip([p.remote for p in pairs],
                                         pool.map(lambda p: drive.info(p.remote) is not None, pairs)))
        for pair in pairs:
            local_ok = os.path.isdir(pair.local)
            if not local_ok:
                problems.append(f"{show(pair.local)} doesn't exist")
            state = "?" if not online else ("exists" if remote_exists.get(pair.remote) else "not created yet")
            print(f"  {show(pair.local):<30} {'exists' if local_ok else RED + 'missing' + RESET}")
            print(f"  {'':<30} {DIM}: {pair.remote} ({state})   last: {last_line(pair)}{RESET}")
        print()
    if problems:
        print(f"{RED}Problems:{RESET}")
        for problem in problems:
            print(f"  {problem}")
        return ERROR
    return OK


def last_line(entry):
    record = read_json(run_path(entry), None)
    if not record:
        return "never"
    return f"{record['result']} {when(record['started'])}"


def cmd_preview(kind, paths, excluded):
    config = config_or_die()
    backups, pairs = select(config, kind, paths)
    if not backups and not pairs:
        print("Nothing is set up. Add folders with \"ezproton edit backup\" or \"ezproton edit sync\".")
        return OK
    drive = Drive()
    preflight(config, backups, pairs, drive, True)
    total_backup = total_sync = 0
    for entry in backups:
        plan = plan_backup(entry, config, drive)
        print_plan(plan, config)
        total_backup += plan.deletions
        if excluded:
            print_excluded(plan)
        print()
    for pair in pairs:
        plan = plan_sync(pair, config, drive)
        print_plan(plan, config)
        total_sync += plan.deletions
        if excluded:
            print_excluded(plan)
        print()
    for label, total in (("backup", total_backup), ("sync", total_sync)):
        if total > config.delete_limit:
            print(f"{YELLOW}A {label} run would delete {plural(total, 'item')}, more than the limit of "
                  f"{config.delete_limit}: it will stop and ask you to repeat it with --yes.{RESET}")
    return OK


def print_excluded(plan):
    entry = plan.entry
    base = os.path.dirname(entry.local) if entry.kind == "backup" and os.path.isfile(entry.local) else entry.local
    scan = plan.scan
    if not scan.excluded and not scan.unreadable:
        return
    print(f"  {BOLD}skipped{RESET}")
    for rel, rule in sorted(scan.excluded.items()):
        print(f"  {rule:<28} {show(rel_join(base, rel))}")
    for rel, reason in sorted(scan.unreadable.items()):
        print(f"  {'(' + reason + ')':<28} {show(rel_join(base, rel))}")


def cmd_last(kind, paths, show_log):
    config = config_or_die()
    backups, pairs = select(config, kind, paths)
    for entry in backups + pairs:
        record = read_json(run_path(entry), None)
        title = f"{BOLD}{entry.kind} {show(entry.local)}{RESET}"
        if show_log:
            print(f"{title}\n")
            log_path = run_path(entry)[:-5] + ".log"
            try:
                with open(log_path) as handle:
                    print(handle.read())
            except OSError:
                print("  no run recorded yet\n")
            continue
        if not record:
            print(f"{title}: never run\n")
            continue
        colour = {"success": GREEN, "partial": YELLOW}.get(record["result"], RED)
        took = record["finished"] - record["started"]
        print(f"{title}: {colour}{record['result']}{RESET}, {when(record['started'])}, took {int(took)} s"
              + ("  (undone)" if record.get("undone") else ""))
        if record.get("message"):
            print(f"  {record['message']}")
        outcome = Outcome(uploaded=record["uploaded"], downloaded=record["downloaded"],
                          trashed_remote=record["trashed_remote"], trashed_local=record["trashed_local"],
                          conflicts=record["conflicts"])
        print(f"  {describe(outcome, entry.kind)}")
        for line in record.get("skipped", []) + record.get("failed", []):
            print(f"  {YELLOW}skipped: {line}{RESET}")
        print()
    return OK



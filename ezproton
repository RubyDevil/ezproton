@dataclass
class Action:
    op: str            # upload, upload_dir, mkdir_remote, trash_remote, download, download_dir,
                       # mkdir_local, trash_local, conflict
    rel: str
    new: bool = True   # upload/download: a new item (not a new version / not replacing)
    count: int = 1     # files affected (for deletion counting)
    remote: Remote = None
    local: Local = None


@dataclass
class Plan:
    entry: object
    actions: list = field(default_factory=list)
    scan: Scan = None
    remote: dict = None
    notes: list = field(default_factory=list)

    @property
    def deletions(self):
        return sum(a.count for a in self.actions if a.op in ("trash_remote", "trash_local"))


LABELS = {
    "upload": "upload",
    "upload_dir": "upload",
    "mkdir_remote": "create folder on Drive",
    "trash_remote": "trash on Drive",
    "download": "download",
    "download_dir": "download",
    "mkdir_local": "create folder locally",
    "trash_local": "trash locally",
    "conflict": "conflict",
}


def topmost(rels):
    """Drop paths that are inside another path in the list."""
    out = []
    for rel in sorted(rels):
        if not any(is_under(rel, kept) for kept in out):
            out.append(rel)
    return out


def count_under(rel, items):
    files = sum(1 for r, v in items.items() if is_under(r, rel) and (v.get("type") if isinstance(v, dict) else v.type) == "file")
    return max(files, 1)


# Backup planning ----------------------------------------------------------------------------


def plan_backup(entry, config, drive):
    plan = Plan(entry)
    if not os.path.lexists(entry.local):
        raise EzError(f"{show(entry.local)} doesn't exist, so nothing was backed up.")
    single = os.path.isfile(entry.local) and not os.path.isdir(entry.local)
    scan = scan_local(entry.local, config, single_file=single)
    plan.scan = scan
    manifest = load_state(entry)
    first_run = manifest is None
    manifest = manifest or {}
    remote = None
    if entry.mode == "mirror":
        remote_base = config.backup_root if single else entry.remote
        remote = drive.walk(remote_base) if drive.info(remote_base) else {}
        if single:
            remote = {k: v for k, v in remote.items() if k == entry.name}
        plan.remote = remote
    local = scan.entries

    def protected(rel):
        """Items that must not be trashed: unreadable ones, or folders holding one."""
        return any(is_under(rel, bad) or is_under(bad, rel) for bad in scan.unreadable)

    covered = set()
    if not single and not manifest and "" not in scan.dirty and not scan.unreadable:
        # Nothing recorded yet and nothing to skip: upload the whole folder in one go.
        # proton-drive merges into an existing folder and skips content it already has.
        plan.actions.append(Action("upload_dir", "", count=sum(1 for e in local.values() if e.type == "file")))
        covered = set(local)
    else:
        new_dirs = [rel for rel, e in local.items() if e.type == "dir" and rel not in manifest
                    and not (remote is not None and rel in remote and remote[rel].type == "dir")]
        for rel in sorted(new_dirs):
            if any(is_under(rel, c) for c in covered):
                continue
            if rel not in scan.dirty:
                files_inside = sum(1 for r, e in local.items() if e.type == "file" and is_under(r, rel))
                plan.actions.append(Action("upload_dir", rel, count=files_inside))
                covered.update(r for r in local if is_under(r, rel))
            else:
                plan.actions.append(Action("mkdir_remote", rel))
        for rel, item in sorted(local.items()):
            if item.type != "file" or rel in covered:
                continue
            known = manifest.get(rel)
            changed = known is None or known.get("size") != item.size or known.get("mtime_ns") != item.mtime_ns
            if not changed and remote is not None:
                r = remote.get(rel)
                changed = r is None or r.type != "file" or bool(r.sha1 and known.get("sha1") and r.sha1 != known["sha1"])
            if changed:
                is_new = known is None and not (remote is not None and rel in remote)
                plan.actions.append(Action("upload", rel, new=is_new, local=item))

    # Deletions
    trashed = set()
    if not first_run:
        gone = [rel for rel in manifest if rel not in local and not protected(rel)]
        for rel in topmost(gone):
            plan.actions.append(Action("trash_remote", rel, count=count_under(rel, manifest)))
            trashed.add(rel)
    if remote is not None:
        extra = [rel for rel in remote if rel not in local and not protected(rel)
                 and not any(is_under(rel, t) for t in trashed)]
        for rel in topmost(extra):
            plan.actions.append(Action("trash_remote", rel, count=count_under(rel, remote), remote=remote[rel]))
    return plan


# Sync planning ------------------------------------------------------------------------------


def plan_sync(entry, config, drive):
    plan = Plan(entry)
    if not os.path.isdir(entry.local):
        raise EzError(f"{show(entry.local)} doesn't exist, so it wasn't synced.")
    scan = scan_local(entry.local, config)
    plan.scan = scan
    state = load_state(entry)
    if drive.info(entry.remote) is None:
        if state:
            raise EzError(
                f"the Drive folder {entry.remote} for {show(entry.local)} is missing. ezproton won't treat that as "
                "\"everything was deleted\". Restore it on drive.proton.me, or remove the pair and add it again."
            )
        everything = {}
        plan.actions.append(Action("mkdir_remote", ""))
    else:
        everything = drive.walk(entry.remote)
    remote, remote_dirty = {}, set()
    for rel, r in everything.items():
        if excluded_path(rel, config):
            parts = rel.split("/")
            for i in range(len(parts)):
                remote_dirty.add("/".join(parts[:i]))
        else:
            remote[rel] = r
    plan.remote = remote
    state = state or {}
    local = scan.entries

    def protected(rel):
        return any(is_under(rel, bad) or is_under(bad, rel) for bad in scan.unreadable)

    def local_changed(rel):
        s, l = state.get(rel), local.get(rel)
        return l is not None and (s is None or s.get("size") != l.size or s.get("mtime_ns") != l.mtime_ns)

    def remote_changed(rel):
        s, r = state.get(rel), remote.get(rel)
        return r is not None and (s is None or s.get("rev") != r.rev)

    hashes = {}

    def local_sha1(rel):
        if rel not in hashes:
            try:
                hashes[rel] = sha1_of(os.path.join(entry.local, rel))
            except OSError:
                hashes[rel] = None
        return hashes[rel]

    actions, trash_remote, trash_local = [], [], []
    for rel in sorted(set(local) | set(remote) | set(state)):
        if protected(rel):
            continue
        l, r, s = local.get(rel), remote.get(rel), state.get(rel)
        if l and r and l.type != r.type:
            plan.notes.append(f"{rel}: a file on one side and a folder on the other, so it was skipped")
            continue
        kind = (l or r).type if (l or r) else (s or {}).get("type")
        if kind == "dir":
            if l and not r:
                (trash_local.append(rel) if s else actions.append(Action("mkdir_remote", rel)))
            elif r and not l:
                (trash_remote.append(rel) if s else actions.append(Action("mkdir_local", rel, remote=r)))
            continue
        if l and r:
            if s is None:
                if not (l.size == r.size and r.sha1 and local_sha1(rel) == r.sha1):
                    actions.append(Action("conflict", rel, local=l, remote=r))
                continue
            lc, rc = local_changed(rel), remote_changed(rel)
            if lc and not rc:
                if local_sha1(rel) != s.get("sha1"):
                    actions.append(Action("upload", rel, new=False, local=l))
            elif rc and not lc:
                if r.sha1 != s.get("sha1"):
                    actions.append(Action("download", rel, new=False, local=l, remote=r))
            elif lc and rc:
                mine = local_sha1(rel)
                if mine == r.sha1:
                    pass
                elif mine == s.get("sha1"):
                    actions.append(Action("download", rel, new=False, local=l, remote=r))
                elif r.sha1 and r.sha1 == s.get("sha1"):
                    actions.append(Action("upload", rel, new=False, local=l))
                else:
                    actions.append(Action("conflict", rel, local=l, remote=r))
        elif l:
            if s is None or (local_changed(rel) and local_sha1(rel) != s.get("sha1")):
                actions.append(Action("upload", rel, new=True, local=l))
            else:
                trash_local.append(rel)
        elif r:
            if s is None or (remote_changed(rel) and r.sha1 != s.get("sha1")):
                actions.append(Action("download", rel, new=True, remote=r))
            else:
                trash_remote.append(rel)

    # A folder is trashed whole only when nothing inside it is kept; otherwise it's recreated.
    kept = {a.rel for a in actions}

    def keeps_something(rel):
        return any(is_under(k, rel) for k in kept) or any(is_under(p, rel) for p in scan.unreadable)

    def resolve(candidates, side):
        chosen = []
        for rel in topmost(candidates):
            if keeps_something(rel):
                if side == "remote" and rel in remote and remote[rel].type == "dir":
                    actions.append(Action("mkdir_local", rel, remote=remote[rel]))
                if side == "local" and rel in local and local[rel].type == "dir":
                    actions.append(Action("mkdir_remote", rel))
                chosen.extend(resolve([c for c in candidates if c != rel and is_under(c, rel)], side))
            else:
                chosen.append(rel)
        return chosen

    for rel in resolve(trash_remote, "remote"):
        actions.append(Action("trash_remote", rel, count=count_under(rel, remote), remote=remote.get(rel)))
    for rel in resolve(trash_local, "local"):
        actions.append(Action("trash_local", rel, count=count_under(rel, local), local=local.get(rel)))

    # New folders that are clean go over in one transfer instead of file by file.
    def compact(make_op, dir_op, file_op, dirty, items):
        out, covered = [], []
        for action in sorted(actions, key=lambda a: a.rel):
            if any(is_under(action.rel, c) for c in covered) and action.op in (make_op, file_op) and action.new:
                continue
            if action.op == make_op and action.rel and action.rel not in dirty:
                inside = [r for r in items if is_under(r, action.rel)]
                if all(any(a.rel == r and a.op in (make_op, file_op) and a.new for a in actions)
                       for r in inside if r != action.rel):
                    files = sum(1 for r in inside if items[r].type == "file")
                    out.append(Action(dir_op, action.rel, count=files, remote=items.get(action.rel)
                                      if dir_op == "download_dir" else None))
                    covered.append(action.rel)
                    continue
            out.append(action)
        return out

    actions = compact("mkdir_remote", "upload_dir", "upload", scan.dirty, local)
    actions = compact("mkdir_local", "download_dir", "download", remote_dirty, remote)
    plan.actions.extend(actions)
    return plan


def excluded_path(rel, config):
    return any(config.excluded_by(part) for part in rel.split("/"))



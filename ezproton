# Command line
# --------------------------------------------------------------------------------------------


def main(argv):
    if not argv:
        print(HELP)
        return OK
    if argv[0] in ("-h", "--help"):
        print(HELP)
        return OK
    if argv[0] == "--version":
        print(f"ezproton {VERSION}")
        return OK
    command, rest = argv[0], argv[1:]
    if command not in ("backup", "sync", "check", "preview", "last", "undo", "edit"):
        raise UsageError(f"unknown command \"{command}\"")

    flags = {"--yes": False, "--excluded": False, "--log": False}
    editor = None
    positional = []
    i = 0
    while i < len(rest):
        arg = rest[i]
        if arg == "--":
            positional.extend(rest[i + 1:])
            break
        if arg in ("-h", "--help"):
            print(HELP)
            return OK
        if arg == "--editor":
            if i + 1 >= len(rest):
                raise UsageError("--editor needs a command")
            editor = rest[i + 1]
            i += 2
            continue
        if arg in flags:
            flags[arg] = True
        elif arg.startswith("-"):
            raise UsageError(f"unknown option \"{arg}\"")
        else:
            positional.append(arg)
        i += 1

    allowed = {"backup": {"--yes"}, "sync": {"--yes"}, "check": set(), "preview": {"--excluded"},
               "last": {"--log"}, "undo": {"--yes"}, "edit": set()}[command]
    for flag, value in flags.items():
        if value and flag not in allowed:
            raise UsageError(f"{flag} doesn't apply to {command}")
    if editor is not None and command != "edit":
        raise UsageError("--editor only applies to edit")

    if command == "edit":
        if len(positional) > 1:
            raise UsageError("edit takes one file name")
        return cmd_edit(positional[0] if positional else None, editor)

    if command == "undo":
        if not positional or positional[0] != "last":
            raise UsageError("use: ezproton undo last [backup|sync] [PATH...]")
        positional = positional[1:]

    kind = None
    if command in ("backup", "sync"):
        kind = command
    elif positional and positional[0] in ("backup", "sync"):
        kind = positional.pop(0)

    if command in ("backup", "sync"):
        return cmd_run(kind, positional, flags["--yes"])
    if command == "check":
        return cmd_check(kind, positional)
    if command == "preview":
        return cmd_preview(kind, positional, flags["--excluded"])
    if command == "last":
        return cmd_last(kind, positional, flags["--log"])
    return cmd_undo(kind, positional, flags["--yes"])


def entry_point():
    try:
        sys.exit(main(sys.argv[1:]))
    except UsageError as error:
        print(f"ezproton: {error}", file=sys.stderr)
        print("Run \"ezproton --help\" for the commands.", file=sys.stderr)
        sys.exit(ERROR)
    except EzError as error:
        print(f"{RED}ezproton: {error}{RESET}", file=sys.stderr)
        sys.exit(error.code)
    except KeyboardInterrupt:
        print("\nezproton: interrupted.", file=sys.stderr)
        sys.exit(ERROR)


if __name__ == "__main__":
    entry_point()

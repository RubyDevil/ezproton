def clean_lines(text):
    """The useful lines of a config file as (line number, text): no Windows line endings, no
    spaces around the text, no blank lines, no # comments, no repeats."""
    seen, out = set(), []
    for number, line in enumerate(text.splitlines(), 1):
        line = line.rstrip("\r").strip()
        if not line or line.startswith("#") or line in seen:
            continue
        seen.add(line)
        out.append((number, line))
    return out


def split_fields(line, separator):
    """Split on the separator, except where it's escaped with a backslash."""
    fields, current, i = [], "", 0
    while i < len(line):
        if line.startswith("\\" + separator, i):
            current += separator
            i += len(separator) + 1
        elif line.startswith(separator, i):
            fields.append(current.strip())
            current = ""
            i += len(separator)
        else:
            current += line[i]
            i += 1
    fields.append(current.strip())
    return fields


def config_path(text):
    """A config path: must start with / or ~/. Tidied without following symlinks."""
    if text == "~" or text.startswith("~/"):
        text = HOME + text[1:]
    if not text.startswith("/"):
        return None
    return os.path.normpath(text)


def clean_drive_path(text):
    text = text.rstrip("/") if text != "/" else text
    if not (text == DRIVE_ROOT or text.startswith(DRIVE_ROOT + "/")):
        return None
    if any(part in ("", ".", "..") for part in text.split("/")[1:]):
        return None
    return text


@dataclass
class BackupEntry:
    local: str
    name: str
    mode: str
    remote: str = ""
    kind: str = "backup"

    @property
    def key(self):
        return hashlib.sha1(self.local.encode()).hexdigest()[:16]


@dataclass
class SyncPair:
    local: str
    remote: str
    kind: str = "sync"

    @property
    def name(self):
        return os.path.basename(self.local)

    @property
    def key(self):
        return hashlib.sha1(f"{self.local}\0{self.remote}".encode()).hexdigest()[:16]


@dataclass
class Config:
    backup_root: str = ""
    separator: str = ":"
    delete_limit: int = 50
    backups: list = field(default_factory=list)
    pairs: list = field(default_factory=list)
    excludes: list = field(default_factory=list)
    problems: list = field(default_factory=list)
    warnings: list = field(default_factory=list)

    def excluded_by(self, name):
        for rule in self.excludes:
            if fnmatch.fnmatchcase(name, rule):
                return rule
        return None


def load_config(overrides=None):
    """Read and check all config files. `overrides` replaces a file's text (used by edit)."""
    overrides = overrides or {}
    texts = {}
    for name in CONFIG_FILES:
        if name in overrides:
            texts[name] = overrides[name]
        else:
            try:
                with open(os.path.join(CONFIG_DIR, name)) as handle:
                    texts[name] = handle.read()
            except FileNotFoundError:
                texts[name] = ""
    config = Config(backup_root=f"{DRIVE_ROOT}/Backups/{HOSTNAME}")
    problems = config.problems

    # settings
    for number, line in clean_lines(texts["settings"]):
        where = f"settings line {number}"
        if " #" in line:
            line = line.split(" #", 1)[0].rstrip()
        key, eq, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if not eq:
            problems.append(f"{where}: expected \"name = value\", got \"{line}\"")
        elif key == "backup-root":
            value = value.replace("<hostname>", HOSTNAME)
            cleaned = clean_drive_path(value)
            if cleaned is None:
                problems.append(f"{where}: backup-root \"{value}\" must be a clean folder path inside {DRIVE_ROOT}")
            else:
                config.backup_root = cleaned
        elif key == "separator":
            if not value or any(c.isspace() for c in value) or any(c in value for c in "/~#\\"):
                problems.append(f"{where}: separator \"{value}\" can't be empty, contain spaces, /, ~, # or \\")
            else:
                config.separator = value
        elif key == "delete-limit":
            if value.isdigit():
                config.delete_limit = int(value)
            else:
                problems.append(f"{where}: delete-limit must be a whole number, got \"{value}\"")
        else:
            problems.append(f"{where}: unknown setting \"{key}\"")
    if config.backup_root == DRIVE_ROOT:
        problems.append(f"settings: backup-root can't be {DRIVE_ROOT} itself")

    sep = config.separator

    # exclude
    for number, line in clean_lines(texts["exclude"]):
        line = line.rstrip("/")
        if "/" in line or not line:
            config.warnings.append(
                f"exclude line {number}: \"{line}\" contains /, but exclusions match names, not paths. Ignored."
            )
            continue
        config.excludes.append(line)

    # backup
    names = {}
    for number, line in clean_lines(texts["backup"]):
        where = f"backup line {number}"
        fields = split_fields(line, sep)
        if len(fields) > 2:
            problems.append(f"{where}: too many \"{sep}\" separators (write \\{sep} for a {sep} in a path)")
            continue
        local = config_path(fields[0])
        if local is None:
            problems.append(f"{where}: \"{fields[0]}\" is not an absolute path. Start it with / or ~/.")
            continue
        mode = fields[1].lower() if len(fields) == 2 else "own"
        if mode not in ("own", "mirror"):
            problems.append(f"{where}: unknown mode \"{fields[1]}\" (use own or mirror)")
            continue
        if local == "/":
            problems.append(f"{where}: back up folders inside /, not / itself")
            continue
        if any(b.local == local for b in config.backups):
            continue
        name = os.path.basename(local)
        if name in names:
            problems.append(
                f"{show(names[name])} and {show(local)} would both be backed up as \"{name}\". "
                "Rename one of them, or list their parent folders instead."
            )
            continue
        names[name] = local
        config.backups.append(BackupEntry(local, name, mode, drive_join(config.backup_root, name)))

    # sync
    for number, line in clean_lines(texts["sync"]):
        where = f"sync line {number}"
        fields = split_fields(line, sep)
        if len(fields) != 2:
            problems.append(
                f"{where}: expected \"laptop folder {sep} Drive folder\" "
                f"(write \\{sep} for a {sep} inside a path)"
            )
            continue
        local = config_path(fields[0])
        if local is None:
            problems.append(f"{where}: \"{fields[0]}\" is not an absolute path. Start it with / or ~/.")
            continue
        remote = clean_drive_path(fields[1])
        if remote is None or remote == DRIVE_ROOT:
            problems.append(f"{where}: \"{fields[1]}\" must be a clean folder path inside {DRIVE_ROOT}")
            continue
        if local == "/":
            problems.append(f"{where}: sync folders inside /, not / itself")
            continue
        if any(p.local == local for p in config.pairs):
            problems.append(f"{where}: {show(local)} is listed twice in sync")
            continue
        config.pairs.append(SyncPair(local, remote))

    # overlaps
    def nested(a, b):
        return a == b or a.startswith(b.rstrip("/") + "/")

    locals_ = [(e.local, f"backup {show(e.local)}") for e in config.backups] + [
        (p.local, f"sync {show(p.local)}") for p in config.pairs
    ]
    for b in config.backups:
        if any(p.local == b.local for p in config.pairs):
            problems.append(f"{show(b.local)} is in both backup and sync. Choose one.")
    for i, (a, label_a) in enumerate(locals_):
        for j, (b, label_b) in enumerate(locals_):
            if i != j and a != b and nested(a, b):
                problems.append(f"{label_a} is inside {label_b}. Folders can't overlap.")
    remotes = [(p.remote, f"Drive folder {p.remote}") for p in config.pairs]
    for i, (a, label_a) in enumerate(remotes):
        for j, (b, label_b) in enumerate(remotes):
            if i != j and nested(a, b):
                problems.append(f"{label_a} (sync) overlaps {label_b}. Drive folders can't overlap.")
        if config.backups and (nested(a, config.backup_root) or nested(config.backup_root, a)):
            problems.append(f"{label_a} (sync) overlaps the backup root {config.backup_root}.")
    return config


def config_or_die():
    config = load_config()
    for message in config.warnings:
        warn(message)
    if config.problems:
        raise EzError("the config has problems, so nothing was done:\n  " + "\n  ".join(config.problems))
    return config



@dataclass
class Local:
    rel: str
    type: str
    size: int = 0
    mtime_ns: int = 0


@dataclass
class Scan:
    entries: dict = field(default_factory=dict)     # rel -> Local (readable files and folders)
    unreadable: dict = field(default_factory=dict)  # rel -> reason
    excluded: dict = field(default_factory=dict)    # rel -> rule or "(symlink)"
    dirty: set = field(default_factory=set)         # folders with something skipped inside

    def mark_dirty(self, rel):
        while True:
            rel = parent_rel(rel) if rel else None
            if rel is None:
                return
            self.dirty.add(rel)
            if rel == "":
                return


def scan_local(root, config, single_file=False):
    """Walk a local folder. Symlinks, excluded names and ezproton's temp folder are skipped."""
    scan = Scan()
    if single_file:
        name = os.path.basename(root)
        try:
            info = os.stat(root, follow_symlinks=False)
            if not os.access(root, os.R_OK):
                scan.unreadable[name] = "can't be read"
            else:
                scan.entries[name] = Local(name, "file", info.st_size, info.st_mtime_ns)
        except OSError as error:
            scan.unreadable[name] = error.strerror
        return scan

    def walk(path, rel):
        try:
            iterator = list(os.scandir(path))
        except OSError as error:
            scan.unreadable[rel] = error.strerror or "can't be read"
            scan.mark_dirty(rel) if rel else scan.dirty.add("")
            return
        for entry in iterator:
            name = entry.name
            child = f"{rel}/{name}" if rel else name
            if name == TMP_NAME:
                continue
            rule = config.excluded_by(name)
            if rule:
                scan.excluded[child] = rule
                scan.mark_dirty(child)
                continue
            try:
                if entry.is_symlink():
                    scan.excluded[child] = "(symlink)"
                    scan.mark_dirty(child)
                elif entry.is_dir(follow_symlinks=False):
                    scan.entries[child] = Local(child, "dir")
                    walk(entry.path, child)
                elif entry.is_file(follow_symlinks=False):
                    info = entry.stat(follow_symlinks=False)
                    if os.access(entry.path, os.R_OK):
                        scan.entries[child] = Local(child, "file", info.st_size, info.st_mtime_ns)
                    else:
                        scan.unreadable[child] = "can't be read"
                        scan.mark_dirty(child)
                else:
                    scan.excluded[child] = "(special file)"
                    scan.mark_dirty(child)
            except OSError as error:
                scan.unreadable[child] = error.strerror or "can't be read"
                scan.mark_dirty(child)

    walk(root, "")
    return scan


def stat_matches(path, size, mtime_ns):
    try:
        info = os.stat(path, follow_symlinks=False)
    except OSError:
        return False
    return info.st_size == size and info.st_mtime_ns == mtime_ns


# Desktop trash (freedesktop.org standard) ---------------------------------------------------


def trash_local(path):
    """Move a file or folder to the desktop trash. Returns where it went, for undo."""
    trash = os.path.join(DATA_HOME, "Trash")
    files, info = os.path.join(trash, "files"), os.path.join(trash, "info")
    os.makedirs(files, mode=0o700, exist_ok=True)
    os.makedirs(info, mode=0o700, exist_ok=True)
    base = os.path.basename(path.rstrip("/"))
    for n in range(1, 10000):
        name = base if n == 1 else f"{base}.{n}"
        info_path = os.path.join(info, name + ".trashinfo")
        try:
            fd = os.open(info_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            continue
        if os.path.lexists(os.path.join(files, name)):
            os.close(fd)
            os.unlink(info_path)
            continue
        with os.fdopen(fd, "w") as handle:
            handle.write("[Trash Info]\n")
            handle.write(f"Path={urllib.parse.quote(os.path.abspath(path))}\n")
            handle.write(f"DeletionDate={time.strftime('%Y-%m-%dT%H:%M:%S')}\n")
        target = os.path.join(files, name)
        try:
            shutil.move(path, target)
        except OSError:
            os.unlink(info_path)
            raise
        return {"file": target, "info": info_path}
    raise OSError(errno.EEXIST, "the desktop trash has too many items with this name")


def untrash_local(record, destination):
    if os.path.lexists(destination):
        return False
    os.makedirs(os.path.dirname(destination), exist_ok=True)
    shutil.move(record["file"], destination)
    try:
        os.unlink(record["info"])
    except OSError:
        pass
    return True


# --------------------------------------------------------------------------------------------
# State: what ezproton remembers between runs
# --------------------------------------------------------------------------------------------


def state_path(entry):
    return os.path.join(STATE_DIR, entry.kind, entry.key + ".json")


def run_path(entry):
    return os.path.join(STATE_DIR, "runs", entry.kind, entry.key + ".json")


def load_state(entry):
    return read_json(state_path(entry), {}).get("items", None)


def save_state(entry, items):
    atomic_write(state_path(entry), json.dumps({"local": entry.local, "items": items}))


class Lock:
    def __enter__(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        self.handle = open(os.path.join(STATE_DIR, "lock"), "w")
        try:
            fcntl.flock(self.handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            self.handle.close()
            raise EzError("another ezproton run is already running.")
        return self

    def __exit__(self, *exc):
        self.handle.close()



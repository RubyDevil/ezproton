def show(path):
    """A local path with the home folder written as ~."""
    if path == HOME:
        return "~"
    if path.startswith(HOME + os.sep):
        return "~/" + path[len(HOME) + 1:]
    return path


def human(size):
    size = float(size)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if size < 1024 or unit == "TiB":
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024


def plural(count, word):
    return f"{count} {word}" + ("" if count == 1 else "s")


def ago(epoch):
    seconds = time.time() - epoch
    if seconds < 90:
        return "just now"
    if seconds < 90 * 60:
        return f"{int(seconds // 60)} min ago"
    if seconds < 48 * 3600:
        return f"{int(seconds // 3600)} h ago"
    return f"{int(seconds // 86400)} days ago"


def when(epoch):
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(epoch)) + f" ({ago(epoch)})"


def warn(message):
    print(f"{YELLOW}{message}{RESET}", file=sys.stderr)


def sha1_of(path):
    digest = hashlib.sha1()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def parse_time(text):
    """Proton's ISO times, such as 2026-11-11T03:56:11.014Z, as epoch seconds."""
    if not text:
        return None
    try:
        return datetime.datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def drive_join(base, *names):
    path = base.rstrip("/")
    for name in names:
        if name:
            path += "/" + name.replace("/", "\\/")
    return path


def rel_join(base, rel):
    return os.path.join(base, rel) if rel else base


def parent_rel(rel):
    return os.path.dirname(rel)


def is_under(rel, ancestor):
    return ancestor == "" or rel == ancestor or rel.startswith(ancestor + "/")


def atomic_write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w") as handle:
        handle.write(text)
    os.replace(tmp, path)


def read_json(path, default):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default


def ask(prompt, choices):
    """Ask on the terminal until one of `choices` (or an empty answer for the first) is typed."""
    while True:
        try:
            answer = input(prompt).strip().lower()
        except EOFError:
            return choices[0]
        if answer == "":
            return choices[0]
        if answer in choices:
            return answer



class DriveError(EzError):
    pass


@dataclass
class Remote:
    rel: str
    type: str
    uid: str
    rev: str = ""
    size: int = 0
    sha1: str = ""
    mtime: float = 0.0


class Drive:
    """Calls Proton's CLI. Every call is logged, so 'last --log' can show it."""

    def __init__(self):
        self.log = []

    def run(self, *args, timeout=CALL_TIMEOUT):
        try:
            result = subprocess.run(
                ["proton-drive", *args], capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=timeout
            )
        except FileNotFoundError:
            raise DriveError("proton-drive is not installed. Install it with ezproton's install.sh, "
                             "or from https://proton.me/download/drive/cli")
        except subprocess.TimeoutExpired:
            raise DriveError(f"proton-drive {' '.join(args[:2])} timed out after {timeout:g} s "
                             "(check the internet connection)")
        self.log.append(f"$ proton-drive {shlex.join(args)}\n{result.stdout}{result.stderr}")
        return result

    @staticmethod
    def not_found(result):
        text = result.stdout + result.stderr
        return "not found" in text.lower()

    def check_login(self):
        result = self.run("filesystem", "info", "--json", DRIVE_ROOT)
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).strip().splitlines()
            raise DriveError(
                "can't reach Proton Drive (not logged in, or offline). Log in with \"proton-drive auth login\", "
                "and check the internet connection."
                + (f"\n  {detail[-1]}" if detail else "")
            )

    def info(self, path):
        result = self.run("filesystem", "info", "--json", path)
        if result.returncode != 0:
            if self.not_found(result):
                return None
            raise DriveError(f"can't read {path} on Drive: {(result.stderr or result.stdout).strip()}")
        try:
            return json.loads(result.stdout)
        except ValueError:
            raise DriveError(f"unexpected output from proton-drive info {path}")

    def list(self, path):
        result = self.run("filesystem", "list", "--json", path)
        if result.returncode != 0:
            raise DriveError(f"can't list {path} on Drive: {(result.stderr or result.stdout).strip()}")
        try:
            return json.loads(result.stdout or "[]")
        except ValueError:
            raise DriveError(f"unexpected output from proton-drive list {path}")

    def create_folder(self, parent, name):
        result = self.run("filesystem", "create-folder", parent, name)
        if result.returncode != 0 and "already exists" not in (result.stdout + result.stderr):
            raise DriveError(f"can't create {drive_join(parent, name)} on Drive: {(result.stderr or result.stdout).strip()}")

    def mkdirs(self, path):
        """Make sure a Drive folder exists, creating each missing level."""
        if self.info(path) is not None:
            return False
        parts = path[len(DRIVE_ROOT) + 1:].split("/")
        current = DRIVE_ROOT
        for part in parts:
            target = drive_join(current, part)
            if self.info(target) is None:
                self.create_folder(current, part)
            current = target
        return True

    def upload(self, sources, parent):
        """Upload local files or folders into a Drive folder. Returns (ok, failed names)."""
        result = self.run("filesystem", "upload", "--file-conflict-strategy", "create-new-revision",
                          "--folder-conflict-strategy", "merge", *sources, parent, timeout=None)
        failed = set()
        in_failed = False
        for line in result.stdout.splitlines():
            stripped = line.strip()
            if stripped.startswith("Failed:"):
                in_failed = True
            elif in_failed and stripped.startswith("- "):
                failed.add(stripped[2:].split(": ", 1)[0])
        if result.returncode != 0 and not failed:
            failed.add("*")
        return result.returncode == 0, failed

    def download(self, sources, folder):
        result = self.run("filesystem", "download", "--file-conflict-strategy", "remove", *sources, folder,
                          timeout=None)
        return result.returncode == 0

    def trash(self, paths):
        """Trash several paths; on a failure, retry one by one. Returns the paths that failed."""
        if not paths:
            return []
        result = self.run("filesystem", "trash", *paths)
        if result.returncode == 0:
            return []
        failed = []
        for path in paths:
            single = self.run("filesystem", "trash", path)
            if single.returncode != 0 and not (self.not_found(single) and self.info(path) is None):
                failed.append(path)
        return failed

    def restore(self, name):
        result = self.run("filesystem", "restore", drive_join("/trash", name))
        text = (result.stdout + result.stderr).strip()
        return result.returncode == 0, text

    def delete_trashed(self, name):
        return self.run("filesystem", "delete", drive_join("/trash", name)).returncode == 0

    def first_in_trash(self, name):
        node = self.info(drive_join("/trash", name))
        return node.get("uid") if node else None

    def walk(self, base):
        """Everything below a Drive folder as {rel: Remote}, listing folders in parallel."""
        found = {}
        with concurrent.futures.ThreadPoolExecutor(LIST_WORKERS) as pool:
            pending = {pool.submit(self.list, base): ""}
            while pending:
                done, _ = concurrent.futures.wait(pending, return_when=concurrent.futures.FIRST_COMPLETED)
                for future in done:
                    prefix = pending.pop(future)
                    for item in future.result():
                        name = (item.get("name") or {}).get("value")
                        if not (item.get("name") or {}).get("ok", True) or not name:
                            continue
                        rel = f"{prefix}/{name}" if prefix else name
                        if item.get("type") == "folder":
                            found[rel] = Remote(rel, "dir", item.get("uid", ""))
                            pending[pool.submit(self.list, f"{DRIVE_ROOT}/{item['uid']}")] = rel
                        elif item.get("type") == "file":
                            rev = item.get("activeRevision") or {}
                            found[rel] = Remote(
                                rel, "file", item.get("uid", ""), rev.get("uid", ""),
                                int(rev.get("claimedSize") or item.get("totalStorageSize") or 0),
                                ((rev.get("claimedDigests") or {}).get("sha1") or "").lower(),
                                parse_time(rev.get("claimedModificationTime")) or parse_time(item.get("modificationTime")) or 0,
                            )
        return found



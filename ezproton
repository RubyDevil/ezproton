# Running plans
# --------------------------------------------------------------------------------------------


@dataclass
class Outcome:
    journal: list = field(default_factory=list)
    uploaded: int = 0
    downloaded: int = 0
    trashed_remote: int = 0
    trashed_local: int = 0
    conflicts: int = 0
    skipped: list = field(default_factory=list)   # "path (reason)"
    failed: list = field(default_factory=list)

    @property
    def partial(self):
        return bool(self.skipped or self.failed)


def run_backup(plan, config, drive, outcome):
    entry = plan.entry
    single = os.path.isfile(entry.local) and not os.path.isdir(entry.local)
    local_base = os.path.dirname(entry.local) if single else entry.local
    remote_base = config.backup_root if single else entry.remote
    scan = plan.scan
    manifest = load_state(entry) or {}
    confirmed = {}   # rel -> manifest record for items now known to be on Drive
    unconfirmed = set()
    actions = plan.actions

    for rel in scan.unreadable:
        outcome.skipped.append(f"{show(rel_join(local_base, rel))} ({scan.unreadable[rel]})")

    def rpath(rel):
        return drive_join(remote_base, *rel.split("/")) if rel else remote_base

    drive.mkdirs(config.backup_root)
    whole = any(a.op == "upload_dir" and a.rel == "" for a in actions)
    root_existed = drive.info(remote_base) is not None if not single else True
    if not whole and not single:
        drive.mkdirs(remote_base)

    # Folders first, top-down.
    for action in sorted((a for a in actions if a.op == "mkdir_remote"), key=lambda a: a.rel.count("/")):
        if drive.info(rpath(action.rel)) is None:
            drive.create_folder(rpath(parent_rel(action.rel)), os.path.basename(action.rel))
            outcome.journal.append({"op": "mkdir_remote", "remote": rpath(action.rel)})
        confirmed[action.rel] = {"type": "dir"}

    # Uploads, grouped by Drive folder.
    batches = {}
    for action in actions:
        if action.op == "upload_dir" and action.rel == "":
            batches.setdefault(("", "root"), []).append(action)
        elif action.op in ("upload", "upload_dir"):
            batches.setdefault((parent_rel(action.rel), "in"), []).append(action)

    def do_batch(key):
        parent, how = key
        items = batches[key]
        if how == "root":
            ok, failed = drive.upload([entry.local], config.backup_root)
            return items, failed, {entry.local}
        sources = []
        for action in items:
            path = rel_join(local_base, action.rel)
            if action.op == "upload" and not stat_matches(path, action.local.size, action.local.mtime_ns):
                continue
            sources.append(path)
        if not sources:
            return items, set(), set()
        ok, failed = drive.upload(sources, rpath(parent))
        return items, failed, set(sources)

    if batches:
        with concurrent.futures.ThreadPoolExecutor(UPLOAD_WORKERS) as pool:
            results = list(pool.map(do_batch, list(batches)))
        for items, failed, sources in results:
            for action in items:
                path = rel_join(local_base, action.rel)
                if action.op == "upload_dir":
                    inside = {r: e for r, e in scan.entries.items() if is_under(r, action.rel)}
                    if failed:
                        unconfirmed.update(inside)
                        names = sorted(n for n in failed if n != "*")
                        for name in names:
                            matches = [r for r, e in inside.items() if e.type == "file" and os.path.basename(r) == name]
                            for r in matches or [name]:
                                outcome.failed.append(f"{show(rel_join(local_base, r))} (upload failed)")
                        if not names:
                            outcome.failed.append(f"{show(path)} (upload failed)")
                        continue
                    for r, e in inside.items():
                        record = {"type": e.type}
                        if e.type == "file":
                            file_path = rel_join(local_base, r)
                            if not stat_matches(file_path, e.size, e.mtime_ns):
                                unconfirmed.add(r)
                                outcome.skipped.append(f"{show(file_path)} (changed during the upload; will be uploaded again)")
                                continue
                            record.update(size=e.size, mtime_ns=e.mtime_ns, sha1=sha1_of(file_path))
                        confirmed[r] = record
                    outcome.uploaded += action.count
                    if action.rel or not root_existed:
                        outcome.journal.append({"op": "upload_new", "remote": rpath(action.rel), "dir": True})
                    continue
                if path not in sources:
                    unconfirmed.add(action.rel)
                    outcome.skipped.append(f"{show(path)} (changed during the run; left for next time)")
                    continue
                if os.path.basename(path) in failed or "*" in failed:
                    unconfirmed.add(action.rel)
                    outcome.failed.append(f"{show(path)} (upload failed)")
                    continue
                if not stat_matches(path, action.local.size, action.local.mtime_ns):
                    unconfirmed.add(action.rel)
                    outcome.skipped.append(f"{show(path)} (changed during the upload; will be uploaded again)")
                    continue
                digest = sha1_of(path)
                confirmed[action.rel] = {"type": "file", "size": action.local.size,
                                         "mtime_ns": action.local.mtime_ns, "sha1": digest}
                outcome.uploaded += 1
                outcome.journal.append({"op": "upload_new" if action.new else "upload_version",
                                        "remote": rpath(action.rel), "sha1": digest})

    # Deletions, to Drive's trash. The IDs are recorded for undo.
    trash_actions = [a for a in actions if a.op == "trash_remote"]
    trashed = set()
    if trash_actions:
        targets = {rpath(a.rel): a for a in trash_actions}

        def uid_for(item):
            path, action = item
            if action.remote is not None:
                return path, action.remote.uid
            node = drive.info(path)
            return path, node.get("uid") if node else None

        with concurrent.futures.ThreadPoolExecutor(LIST_WORKERS) as pool:
            uids = dict(pool.map(uid_for, targets.items()))
        existing = {f"{DRIVE_ROOT}/{uids[p]}": p for p in targets if uids.get(p)}
        failed = set(drive.trash(list(existing)))
        for path, action in targets.items():
            uid = uids.get(path)
            if uid and f"{DRIVE_ROOT}/{uid}" in failed:
                outcome.failed.append(f"{path} on Drive (couldn't be moved to the trash)")
                continue
            trashed.add(action.rel)
            if uid:
                outcome.trashed_remote += action.count
                outcome.journal.append({"op": "trash_remote", "remote": path, "uid": uid,
                                        "name": os.path.basename(action.rel)})

    # The new record of what is on Drive.
    new = {}
    for rel, item in scan.entries.items():
        if rel in confirmed:
            new[rel] = confirmed[rel]
        elif rel in manifest:
            new[rel] = {"type": "dir"} if item.type == "dir" else manifest[rel]
    for rel, record in manifest.items():
        if rel in new or any(is_under(rel, t) for t in trashed):
            continue
        if any(is_under(rel, bad) or is_under(bad, rel) for bad in scan.unreadable):
            new[rel] = record
    save_state(entry, new)


def run_sync(plan, config, drive, outcome):
    entry = plan.entry
    base = entry.local
    remote = plan.remote or {}
    state = load_state(entry) or {}
    new_state = dict(state)
    written = set()
    scan = plan.scan
    tmp_root = os.path.join(base, TMP_NAME)
    actions = plan.actions

    for rel in scan.unreadable:
        outcome.skipped.append(f"{show(rel_join(base, rel))} ({scan.unreadable[rel]})")

    def rpath(rel):
        return drive_join(entry.remote, *rel.split("/")) if rel else entry.remote

    def lpath(rel):
        return rel_join(base, rel)

    def remember(rel, record):
        new_state[rel] = record
        written.add(rel)

    def forget(rel):
        for key in [k for k in new_state if is_under(k, rel)]:
            del new_state[key]
        written.add(rel)

    # 1. Folders.
    if any(a.op == "mkdir_remote" and a.rel == "" for a in actions):
        drive.mkdirs(entry.remote)
    for action in sorted((a for a in actions if a.op == "mkdir_remote" and a.rel), key=lambda a: a.rel.count("/")):
        if drive.info(rpath(action.rel)) is None:
            drive.create_folder(rpath(parent_rel(action.rel)), os.path.basename(action.rel))
            outcome.journal.append({"op": "mkdir_remote", "remote": rpath(action.rel)})
        remember(action.rel, {"type": "dir"})
    for action in sorted((a for a in actions if a.op == "mkdir_local"), key=lambda a: a.rel.count("/")):
        if not os.path.isdir(lpath(action.rel)):
            os.makedirs(lpath(action.rel))
            outcome.journal.append({"op": "mkdir_local", "local": lpath(action.rel)})
        remember(action.rel, {"type": "dir"})

    # 2. Conflicts: the laptop copy is renamed and uploaded; the Drive copy is downloaded.
    uploads = [(a.rel, a.local, a.new) for a in actions if a.op == "upload"]
    downloads = [a for a in actions if a.op == "download"]
    for action in (a for a in actions if a.op == "conflict"):
        path = lpath(action.rel)
        if not stat_matches(path, action.local.size, action.local.mtime_ns):
            outcome.skipped.append(f"{show(path)} (changed during the run; left for next time)")
            continue
        renamed = conflict_name(path)
        os.rename(path, renamed)
        outcome.journal.append({"op": "rename_local", "from": path, "to": renamed})
        new_rel = os.path.relpath(renamed, base)
        info = os.stat(renamed)
        uploads.append((new_rel, Local(new_rel, "file", info.st_size, info.st_mtime_ns), True))
        downloads.append(Action("download", action.rel, new=True, remote=action.remote))
        outcome.conflicts += 1

    # 3. Uploads, grouped by Drive folder; whole new folders in one go.
    groups = {}
    for rel, item, is_new in uploads:
        groups.setdefault(parent_rel(rel), []).append(("file", rel, item, is_new))
    for action in (a for a in actions if a.op == "upload_dir"):
        groups.setdefault(parent_rel(action.rel), []).append(("dir", action.rel, None, True))

    def do_upload(parent):
        sources = []
        for kind, rel, item, is_new in groups[parent]:
            if kind == "dir":
                files = {r: e for r, e in scan.entries.items() if is_under(r, rel) and e.type == "file"}
                sources.append((kind, rel, {r: (e, sha1_of(lpath(r))) for r, e in files.items()}, is_new))
            elif stat_matches(lpath(rel), item.size, item.mtime_ns):
                sources.append((kind, rel, (item, sha1_of(lpath(rel))), is_new))
            else:
                outcome.skipped.append(f"{show(lpath(rel))} (changed during the run; left for next time)")
        if not sources:
            return []
        ok, failed = drive.upload([lpath(rel) for _, rel, _, _ in sources], rpath(parent))
        done = []
        for kind, rel, data, is_new in sources:
            if kind == "dir" and failed:
                outcome.failed.append(f"{show(lpath(rel))} (some files failed to upload)")
            elif kind == "file" and (os.path.basename(rel) in failed or "*" in failed):
                outcome.failed.append(f"{show(lpath(rel))} (upload failed)")
            else:
                done.append((kind, rel, data, is_new))
        return done

    uploaded = []
    if groups:
        with concurrent.futures.ThreadPoolExecutor(UPLOAD_WORKERS) as pool:
            for done in pool.map(do_upload, list(groups)):
                uploaded.extend(done)
    if uploaded:
        # Learn the new revisions, and check that Drive has what was hashed.
        folders = sorted({parent_rel(rel) for kind, rel, _, _ in uploaded if kind == "file"})
        with concurrent.futures.ThreadPoolExecutor(LIST_WORKERS) as pool:
            listings = dict(zip(folders, pool.map(lambda p: drive.list(rpath(p)), folders)))
        seen = {}
        for parent, items in listings.items():
            for node in items:
                name = (node.get("name") or {}).get("value")
                if name:
                    seen[f"{parent}/{name}" if parent else name] = node
        trees = {rel: drive.walk(rpath(rel)) for kind, rel, _, _ in uploaded if kind == "dir"}
        for kind, rel, data, is_new in uploaded:
            if kind == "dir":
                remember(rel, {"type": "dir"})
                tree = trees.get(rel, {})
                for sub, r in tree.items():
                    full = f"{rel}/{sub}"
                    if r.type == "dir":
                        remember(full, {"type": "dir"})
                    elif full in data:
                        item, digest = data[full]
                        if r.sha1 == digest and stat_matches(lpath(full), item.size, item.mtime_ns):
                            remember(full, {"type": "file", "size": item.size, "mtime_ns": item.mtime_ns,
                                            "sha1": digest, "rev": r.rev})
                outcome.uploaded += len(data)
                outcome.journal.append({"op": "upload_new", "remote": rpath(rel), "dir": True})
                continue
            item, digest = data
            node = seen.get(rel) or {}
            rev = node.get("activeRevision") or {}
            remote_sha1 = ((rev.get("claimedDigests") or {}).get("sha1") or "").lower()
            outcome.uploaded += 1
            outcome.journal.append({"op": "upload_new" if is_new else "upload_version",
                                    "remote": rpath(rel), "sha1": digest})
            if remote_sha1 == digest and stat_matches(lpath(rel), item.size, item.mtime_ns):
                remember(rel, {"type": "file", "size": item.size, "mtime_ns": item.mtime_ns,
                               "sha1": digest, "rev": rev.get("uid", "")})
            else:
                # It changed while uploading: forget it, so the next run compares both sides again.
                forget(rel)

    # 4. Downloads into a temporary folder inside the pair, then moved into place.
    dir_downloads = [a for a in actions if a.op == "download_dir"]
    if downloads or dir_downloads:
        os.makedirs(tmp_root, exist_ok=True)
        try:
            by_parent = {}
            for action in downloads:
                by_parent.setdefault(parent_rel(action.rel), []).append(action)
            for index, (parent, group) in enumerate(sorted(by_parent.items())):
                staging = os.path.join(tmp_root, f"f{index}")
                os.makedirs(staging)
                ok = drive.download([rpath(a.rel) for a in group], staging)
                for action in group:
                    place_download(action, os.path.join(staging, os.path.basename(action.rel)),
                                   lpath(action.rel), outcome, remember, ok)
            for index, action in enumerate(dir_downloads):
                staging = os.path.join(tmp_root, f"d{index}")
                os.makedirs(staging)
                target = lpath(action.rel)
                fetched = os.path.join(staging, os.path.basename(action.rel))
                if not drive.download([rpath(action.rel)], staging) or not os.path.isdir(fetched):
                    outcome.failed.append(f"{show(target)} (download failed)")
                    continue
                if os.path.lexists(target):
                    outcome.skipped.append(f"{show(target)} (appeared during the run; left for next time)")
                    continue
                os.makedirs(os.path.dirname(target), exist_ok=True)
                os.rename(fetched, target)
                remember(action.rel, {"type": "dir"})
                count = 0
                for rel, r in remote.items():
                    if not is_under(rel, action.rel) or rel == action.rel:
                        continue
                    if r.type == "dir":
                        remember(rel, {"type": "dir"})
                        continue
                    path = lpath(rel)
                    if not os.path.isfile(path):
                        continue
                    if r.mtime:
                        os.utime(path, (r.mtime, r.mtime))
                    info = os.stat(path)
                    remember(rel, {"type": "file", "size": info.st_size, "mtime_ns": info.st_mtime_ns,
                                   "sha1": r.sha1, "rev": r.rev})
                    count += 1
                outcome.downloaded += count
                outcome.journal.append({"op": "download_new", "local": target, "dir": True})
        finally:
            shutil.rmtree(tmp_root, ignore_errors=True)

    # 5. Deletions.
    remote_trash = [a for a in actions if a.op == "trash_remote"]
    if remote_trash:
        paths = [f"{DRIVE_ROOT}/{a.remote.uid}" if a.remote and a.remote.uid else rpath(a.rel) for a in remote_trash]
        failed = set(drive.trash(paths))
        for action, path in zip(remote_trash, paths):
            if path in failed:
                outcome.failed.append(f"{rpath(action.rel)} on Drive (couldn't be moved to the trash)")
                continue
            outcome.trashed_remote += action.count
            outcome.journal.append({"op": "trash_remote", "remote": rpath(action.rel),
                                    "uid": action.remote.uid if action.remote else "",
                                    "name": os.path.basename(action.rel)})
            forget(action.rel)
    for action in (a for a in actions if a.op == "trash_local"):
        path = lpath(action.rel)
        if action.local and action.local.type == "file" and not stat_matches(path, action.local.size, action.local.mtime_ns):
            outcome.skipped.append(f"{show(path)} (changed during the run; left for next time)")
            continue
        try:
            record = trash_local(path)
        except OSError as error:
            outcome.failed.append(f"{show(path)} (couldn't be moved to the trash: {error.strerror})")
            continue
        outcome.trashed_local += action.count
        outcome.journal.append({"op": "trash_local", "local": path, "trashed": record})
        forget(action.rel)

    # 6. Everything that was already in sync is remembered as it is now.
    for rel, item in scan.entries.items():
        r = remote.get(rel)
        if rel in written or r is None or r.type != item.type:
            continue
        if item.type == "dir":
            new_state[rel] = {"type": "dir"}
            continue
        old = state.get(rel)
        if old and old.get("size") == item.size and old.get("mtime_ns") == item.mtime_ns and old.get("rev") == r.rev:
            continue
        if not stat_matches(lpath(rel), item.size, item.mtime_ns):
            continue
        if old and old.get("sha1") and old.get("sha1") == r.sha1:
            new_state[rel] = dict(old, size=item.size, mtime_ns=item.mtime_ns, rev=r.rev)
        elif r.sha1 and sha1_of(lpath(rel)) == r.sha1:
            new_state[rel] = {"type": "file", "size": item.size, "mtime_ns": item.mtime_ns, "sha1": r.sha1, "rev": r.rev}
    for rel in state:
        if rel in written or rel in scan.entries or rel in remote:
            continue
        if not any(is_under(rel, bad) or is_under(bad, rel) for bad in scan.unreadable):
            new_state.pop(rel, None)
    save_state(entry, new_state)


def place_download(action, fetched, path, outcome, remember, ok):
    r = action.remote
    if not ok and not os.path.isfile(fetched):
        outcome.failed.append(f"{show(path)} (download failed)")
        return
    if not os.path.isfile(fetched):
        outcome.failed.append(f"{show(path)} (download failed)")
        return
    record = None
    if os.path.lexists(path):
        if action.local is None or not stat_matches(path, action.local.size, action.local.mtime_ns):
            outcome.skipped.append(f"{show(path)} (changed during the run; left for next time)")
            return
        record = trash_local(path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    os.replace(fetched, path)
    if r.mtime:
        os.utime(path, (r.mtime, r.mtime))
    info = os.stat(path)
    outcome.downloaded += 1
    if record:
        outcome.journal.append({"op": "download_replace", "local": path, "size": info.st_size,
                                "mtime_ns": info.st_mtime_ns, "trashed": record})
    else:
        outcome.journal.append({"op": "download_new", "local": path, "size": info.st_size,
                                "mtime_ns": info.st_mtime_ns})
    rel = action.rel
    remember(rel, {"type": "file", "size": info.st_size, "mtime_ns": info.st_mtime_ns, "sha1": r.sha1, "rev": r.rev})


def conflict_name(path):
    folder, name = os.path.split(path)
    stem, dot, suffix = name.rpartition(".")
    if not dot or not stem:
        stem, suffix = name, ""
    stamp = time.strftime("%Y-%m-%d %H%M")
    for n in range(1, 1000):
        extra = "" if n == 1 else f" {n}"
        candidate = f"{stem} (conflict {HOSTNAME} {stamp}{extra})" + (f".{suffix}" if suffix else "")
        full = os.path.join(folder, candidate)
        if not os.path.lexists(full):
            return full
    raise EzError(f"can't find a free conflict name for {show(path)}")


# --------------------------------------------------------------------------------------------
# Run records (for last and undo)
# --------------------------------------------------------------------------------------------


def write_record(entry, result, started, outcome, drive, prev_state, message=""):
    log_path = run_path(entry)[:-5] + ".log"
    atomic_write(log_path, "\n".join(drive.log) if drive else message)
    record = {
        "local": entry.local,
        "remote": entry.remote,
        "result": result,
        "message": message,
        "started": started,
        "finished": time.time(),
        "uploaded": outcome.uploaded,
        "downloaded": outcome.downloaded,
        "trashed_remote": outcome.trashed_remote,
        "trashed_local": outcome.trashed_local,
        "conflicts": outcome.conflicts,
        "skipped": outcome.skipped,
        "failed": outcome.failed,
        "journal": outcome.journal,
        "prev_state": prev_state,
        "undone": False,
    }
    atomic_write(run_path(entry), json.dumps(record))



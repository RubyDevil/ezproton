def cmd_undo(kind, paths, yes):
    config = config_or_die()
    backups, pairs = select(config, kind, paths)
    records = []
    for entry in backups + pairs:
        record = read_json(run_path(entry), None)
        if record and not record.get("undone") and record.get("journal") is not None:
            records.append((entry, record))
    if not records:
        raise EzError("there's no run to undo (each run can be undone once).")
    print("Undo will reverse:")
    for entry, record in records:
        print(f"  {entry.kind} {show(entry.local)}  (run of {when(record['started'])}, "
              f"{plural(len(record['journal']), 'action')})")
    if not yes:
        if not sys.stdin.isatty():
            raise EzError("undo needs confirmation: run it in a terminal, or add --yes.")
        if ask("Go ahead? [y/N] ", ["n", "y"]) != "y":
            print("Nothing was changed.")
            return OK
    with Lock():
        drive = Drive()
        drive.check_login()
        worst = OK
        for entry, record in records:
            leftovers = undo_record(entry, record, drive)
            record["undone"] = True
            atomic_write(run_path(entry), json.dumps(record))
            if record.get("prev_state") is None:
                try:
                    os.unlink(state_path(entry))
                except OSError:
                    pass
            else:
                save_state(entry, record["prev_state"])
            if leftovers:
                worst = PARTIAL
                print(f"{YELLOW}{entry.kind} {show(entry.local)}: undone, except:{RESET}")
                for line in leftovers:
                    print(f"  {line}")
            else:
                print(f"{GREEN}{entry.kind} {show(entry.local)}: undone{RESET}")
        return worst


def undo_record(entry, record, drive):
    leftovers = []
    trash_cache = {}
    for item in reversed(record["journal"]):
        op = item["op"]
        try:
            if op == "upload_new":
                node = drive.info(item["remote"])
                if node is None:
                    continue
                current = (((node.get("activeRevision") or {}).get("claimedDigests") or {}).get("sha1") or "").lower()
                if item.get("sha1") and current and current != item["sha1"]:
                    leftovers.append(f"{item['remote']} on Drive changed since the run; left as it is")
                    continue
                if drive.trash([f"{DRIVE_ROOT}/{node['uid']}"]):
                    leftovers.append(f"{item['remote']} on Drive couldn't be moved to the trash")
            elif op == "upload_version":
                leftovers.append(f"{item['remote']}: a new version was uploaded. Pick the previous version in the "
                                 "file's version history on drive.proton.me.")
            elif op == "mkdir_remote":
                node = drive.info(item["remote"])
                if node is not None and not drive.list(f"{DRIVE_ROOT}/{node['uid']}"):
                    drive.trash([f"{DRIVE_ROOT}/{node['uid']}"])
            elif op == "trash_remote":
                message = undo_trash_remote(item, drive, trash_cache)
                if message:
                    leftovers.append(message)
            elif op == "download_new" and item.get("dir"):
                path = item["local"]
                if not os.path.lexists(path):
                    continue
                newer = [os.path.join(d, f) for d, _, fs in os.walk(path) for f in fs
                         if os.lstat(os.path.join(d, f)).st_mtime > record["finished"]]
                if newer:
                    leftovers.append(f"{show(path)} has files changed since the run; left as it is")
                    continue
                trash_local(path)
            elif op == "download_new":
                path = item["local"]
                if not os.path.lexists(path):
                    continue
                if not stat_matches(path, item["size"], item["mtime_ns"]):
                    leftovers.append(f"{show(path)} changed since the run; left as it is")
                    continue
                trash_local(path)
            elif op == "download_replace":
                path = item["local"]
                if os.path.lexists(path) and not stat_matches(path, item["size"], item["mtime_ns"]):
                    leftovers.append(f"{show(path)} changed since the run; left as it is")
                    continue
                if not os.path.lexists(item["trashed"]["file"]):
                    leftovers.append(f"{show(path)}: the old copy is no longer in the desktop trash")
                    continue
                if os.path.lexists(path):
                    trash_local(path)
                untrash_local(item["trashed"], path)
            elif op == "trash_local":
                path = item["local"]
                if not os.path.lexists(item["trashed"]["file"]):
                    leftovers.append(f"{show(path)} is no longer in the desktop trash")
                elif not untrash_local(item["trashed"], path):
                    leftovers.append(f"{show(path)} exists again, so the trashed copy was left in the desktop trash")
            elif op == "mkdir_local":
                try:
                    os.rmdir(item["local"])
                except OSError:
                    pass
            elif op == "rename_local":
                if os.path.lexists(item["from"]):
                    leftovers.append(f"{show(item['from'])} exists, so {show(item['to'])} keeps its conflict name")
                elif os.path.lexists(item["to"]):
                    os.rename(item["to"], item["from"])
        except (OSError, DriveError) as error:
            leftovers.append(f"{item.get('local') or item.get('remote') or item.get('from')}: {error}")
    return leftovers


def undo_trash_remote(item, drive, cache):
    """Restore one item from Drive's trash, making sure it's the right one."""
    name, uid, path = item["name"], item.get("uid"), item["remote"]
    node = drive.info(f"{DRIVE_ROOT}/{uid}") if uid else None
    if uid and (node is None or not node.get("trashTime")):
        return None if node is not None else f"{path}: no longer in Drive's trash"
    first = drive.first_in_trash(name)
    if first is None:
        return f"{path}: no longer in Drive's trash"
    if first != uid:
        if "trash" not in cache:
            cache["trash"] = drive.list("/trash")
        same = [n for n in cache["trash"] if (n.get("name") or {}).get("value") == name and n.get("uid") != uid]
        choice = "m"
        if sys.stdin.isatty():
            print(f"\n{plural(len(same), 'other item')} named \"{name}\" are in the Drive trash ahead of yours "
                  f"({path}).")
            print("  [m] I'll restore it myself on drive.proton.me   (default)")
            print("  [s] Move the others aside, restore mine, then put them back in the trash")
            print("  [d] Permanently delete the others, then restore mine")
            choice = ask("Choice [m/s/d]: ", ["m", "s", "d"])
        if choice == "m":
            return f"{path}: restore it yourself in the trash on drive.proton.me (other items have the same name)"
        if choice == "d":
            print("These will be deleted for good:")
            for n in same:
                size = n.get("totalStorageSize") or (n.get("activeRevision") or {}).get("claimedSize") or 0
                print(f"  {name}  {n.get('type')}, {human(size)}, trashed {n.get('trashTime')}")
            try:
                confirm = input("Type delete to confirm: ").strip()
            except EOFError:
                confirm = ""
            if confirm != "delete":
                return f"{path}: not restored (permanent deletion wasn't confirmed). Restore it on drive.proton.me."
            for _ in range(len(same) + 1):
                first = drive.first_in_trash(name)
                if first is None or first == uid:
                    break
                if not drive.delete_trashed(name):
                    return f"{path}: couldn't delete the other items; restore it on drive.proton.me"
            cache.pop("trash", None)
        else:
            moved = []
            for _ in range(len(same) + 1):
                first = drive.first_in_trash(name)
                if first is None or first == uid:
                    break
                ok, text = drive.restore(name)
                if not ok:
                    for other in moved:
                        drive.trash([f"{DRIVE_ROOT}/{other}"])
                    return f"{path}: an item ahead of it couldn't be moved aside ({text}); restore it on drive.proton.me"
                moved.append(first)
            ok, text = drive.restore(name)
            for other in moved:
                drive.trash([f"{DRIVE_ROOT}/{other}"])
            cache.pop("trash", None)
            return None if ok else f"{path}: {text}"
        if drive.first_in_trash(name) != uid:
            return f"{path}: restore it yourself on drive.proton.me"
    ok, text = drive.restore(name)
    cache.pop("trash", None)
    if not ok:
        return f"{path}: {text.splitlines()[-1] if text else 'restore failed'}"
    return None


# edit ---------------------------------------------------------------------------------------


def find_editor(flag):
    for candidate in (flag, os.environ.get("VISUAL"), os.environ.get("EDITOR")):
        if candidate:
            return candidate
    for name in ("nvim", "vim", "nano", "vi"):
        if shutil.which(name):
            return name
    raise EzError("no editor found. Use --editor COMMAND, or set $EDITOR.")


def cmd_edit(name, editor_flag):
    if name is None:
        if not sys.stdin.isatty():
            raise UsageError("choose a file: ezproton edit backup|sync|exclude|settings")
        for index, option in enumerate(CONFIG_FILES, 1):
            print(f"  {index}. {option}")
        answer = ask("Which file? [1-4]: ", ["1", "2", "3", "4"])
        name = CONFIG_FILES[int(answer) - 1]
    if name not in CONFIG_FILES:
        raise UsageError(f"unknown config file \"{name}\". Choose backup, sync, exclude or settings.")
    editor = find_editor(editor_flag)
    path = os.path.join(CONFIG_DIR, name)
    try:
        with open(path) as handle:
            original = handle.read()
    except FileNotFoundError:
        original = None
    os.makedirs(CONFIG_DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f"{name}.", suffix=".edit", dir=CONFIG_DIR)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(original if original is not None else TEMPLATES[name])
        while True:
            status = subprocess.call(shlex.split(editor) + [tmp])
            if status != 0:
                raise EzError(f"the editor exited with status {status}; {name} was not changed.")
            with open(tmp) as handle:
                text = handle.read()
            config = load_config({name: text})
            issues = config.problems + (config.warnings if name == "exclude" else [])
            if not issues:
                break
            print(f"{RED}{name} has problems:{RESET}")
            for issue in issues:
                print(f"  {issue}")
            if not sys.stdin.isatty():
                raise EzError(f"{name} was not changed.")
            choice = ask("[e]dit again, [k]eep anyway, [d]iscard? [e/k/d] ", ["e", "k", "d"])
            if choice == "d":
                print(f"{name} was not changed.")
                return OK
            if choice == "k":
                break
        atomic_write(path, text)
        print(f"Saved {show(path)}.")
        return OK
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


